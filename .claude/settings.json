{
  "permissions": {
    "ask": [
      "WebFetch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh release *)",
      "Bash(gh gist *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/tools/session_start.sh\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_(Gmail|Google_Calendar|Google_Drive|GitHub|Github)__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/external_guard.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__claude_ai_(Gmail|Google_Calendar|Google_Drive|GitHub|Github)__.*",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/external_guard.py\"" }
        ]
      }
    ]
  }
}
